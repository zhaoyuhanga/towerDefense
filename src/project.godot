; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mazing Tower Defense"
config/description="A maze-building tower defense game. Design monster paths with blocks, merge towers by drag-and-drop, survive endless waves."
config/tags=PackedStringArray("tower_defense", "mazing", "strategy", "2d", "pixel_art")
run/main_scene="uid://menu001"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://autoload/signal_bus.gd"
MonsterPoolAutoload="*res://autoload/monster_pool.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/max_physics_steps_per_frame=4
2d/physics_engine="GodotPhysics2D"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
anti_aliasing/screen_space_aa=1
